{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [],
  "default_agent": "build",
  "model": "openai/gpt-6-luna",
  "providers": {
    "openai": {
      "models": {
        "gpt-6-luna": {
          "settings": {
            "reasoningEffort": "max"
          }
        }
      }
    }
  },
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "openai", "effect": "allow" },
    { "action": "provider.use", "resource": "xai", "effect": "allow" },
    { "action": "skill.use", "resource": "pitfalls-maintainer", "effect": "deny" },
    { "action": "skill.use", "resource": "pitfalls-reader", "effect": "deny" },
    { "action": "skill.use", "resource": "web-ui-crafter", "effect": "deny" },
    { "action": "skill.use", "resource": "bug-fixer", "effect": "deny" },
    { "action": "skill.use", "resource": "conventional-commits", "effect": "deny" }
  ],
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" }
  ]
}
