{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [],
  "default_agent": "build",
  "model": "openai/gpt-6-luna",
  "providers": {
    "openai": {
      "models": {
        "gpt-6-luna": {
          "settings": {
            "reasoningEffort": "max"
          }
        }
      }
    }
  },
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "openai", "effect": "allow" },
    { "action": "provider.use", "resource": "xai", "effect": "allow" },
    { "action": "skill.use", "resource": "pitfalls-maintainer", "effect": "deny" },
    { "action": "skill.use", "resource": "pitfalls-reader", "effect": "deny" },
    { "action": "skill.use", "resource": "web-ui-crafter", "effect": "deny" },
    { "action": "skill.use", "resource": "bug-fixer", "effect": "deny" },
    { "action": "skill.use", "resource": "conventional-commits", "effect": "deny" },
    { "action": "skill.use", "resource": "ios-rebuild-validate", "effect": "deny" }
  ],
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp"],
        "environment": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "disabled": false
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "disabled": false
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"],
        "disabled": false
      },
      "brave-search": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@brave/brave-search-mcp-server",
          "--transport",
          "stdio"
        ],
        "environment": {
          "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
        },
        "disabled": false
      },
      "ios-simulator": {
        "type": "local",
        "command": ["npx", "-y", "ios-simulator-mcp"],
        "disabled": false
      }
    }
  }
}
