{
  "renderMarkdown": true,
  "theme": "default",
  "showReasoning": false,
  "model": "claude-sonnet-5.5",
  "effortLevel": "high",
  "keepAlive": "on",
  "defaultPermissionMode": "allow-all",
  "footer": {
    "showModelEffort": true,
    "showDirectory": true,
    "showBranch": true,
    "showContextWindow": true,
    "showQuota": true,
    "showAiUsed": true,
    "showAgent": true,
    "showCodeChanges": false,
    "showUsername": false,
    "showSandbox": true,
    "showYolo": false,
    "showCiStatus": false,
    "showSchedules": true,
    "showPullRequest": true,
    "showCustom": true
  },
  "disabledMcpServers": [
    "figma",
    "launchdarkly"
  ],
  "enabledPlugins": {
    "computer-use": true
  },
  "experimental": true
}
